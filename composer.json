{
    "name": "sergeybruhin/laravel-postgres-tools",
    "description": "PostgreSQL backup and restore Artisan commands with integrity checks for Laravel",
    "keywords": [
        "laravel",
        "postgres",
        "postgresql",
        "backup",
        "restore",
        "pg_dump",
        "database"
    ],
    "homepage": "https://github.com/sergeybruhin/laravel-postgres-tools",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sergey Bruhin",
            "email": "sundaycreative@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/sergeybruhin/laravel-postgres-tools/issues",
        "source": "https://github.com/sergeybruhin/laravel-postgres-tools"
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SergeyBruhin\\PostgresTools\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SergeyBruhin\\PostgresTools\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.4.x-dev"
        },
        "laravel": {
            "providers": [
                "SergeyBruhin\\PostgresTools\\Providers\\PostgresToolsServiceProvider"
            ]
        }
    }
}
